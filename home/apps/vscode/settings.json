{
  "window.titleBarStyle": "custom",
  "terminal.integrated.stickyScroll.enabled": false,
  "catppuccin.accentColor": "pink",
  "catppuccin.italicComments": false,
  "catppuccin.italicKeywords": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontFamily": "Iosevka Term, Symbols Nerd Font, monospace",
  "editor.fontSize": 16,
  "editor.inlayHints.padding": true,
  "editor.lineNumbers": "relative",
  "editor.minimap.autohide": "mouseover",
  "editor.mouseWheelZoom": true,
  "editor.smoothScrolling": true,
  "editor.suggest.preview": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.autoSave": "afterDelay",
  "git.confirmSync": false,
  "nix.enableLanguageServer": true,
  "nix.serverPath": "/home/goudham/.nix-profile/bin/nixd",
  "nix.serverSettings": {
    "nixd": {
      "options": {
        "home-manager": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).homeConfigurations.goudham.options"
        }
      }
    }
  },
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.fontSize": 18,
  "vim.easymotion": true,
  "vim.easymotionDimBackground": false,
  "vim.handleKeys": {
    "<C-a>": false, // select all
    "<C-c>": false, // copy
    "<C-f>": false, // find
    "<C-v>": false, // paste
    "<C-x>": false // cut
  },
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    // Make sure to use VsCode's undo stack -> https://github.com/VSCodeVim/Vim/issues/1490
    {
      "before": ["u"],
      "commands": ["undo"]
    },
    {
      "before": ["<C-r>"],
      "commands": ["redo"]
    },
    {
      "before": ["<C-o>"],
      "commands": ["workbench.action.navigateBack"]
    },
    {
      "before": ["<C-i>"],
      "commands": ["workbench.action.navigateForward"]
    },
    // Helpful Stuff
    {
      "before": ["/"],
      "commands": ["actions.find"]
    },
    {
      "after": ["o", "<ESC>"],
      "before": ["<CR>"]
    },
    {
      "after": ["^"],
      "before": ["0"]
    },
    {
      "after": ["<C-u>", "z", "z"],
      "before": ["<C-u>"]
    },
    {
      "after": ["<C-d>", "z", "z"],
      "before": ["<C-d>"]
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["[", "c"],
      "commands": ["workbench.action.editor.previousChange"]
    },
    {
      "before": ["]", "c"],
      "commands": ["workbench.action.editor.nextChange"]
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"]
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"]
    },
    {
      "before": ["<leader>", "a"],
      "commands": ["workbench.action.showCommands"]
    },
    // EasyMotion
    {
      "after": ["<leader>", "<leader>"],
      "before": ["s"]
    },
    // Git
    {
      "before": ["<leader>", "g", "g"],
      "commands": ["workbench.view.scm"]
    },
    {
      "before": ["<leader>", "g", "h"],
      "commands": ["toggle.diff.renderSideBySide"]
    },
    {
      "before": ["<leader>", "g", "p"],
      "commands": ["git.openChange"]
    },
    // LSP
    {
      "before": ["<leader>", "l", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["<leader>", "l", "r"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": ["<leader>", "l", "a"],
      "commands": ["editor.action.quickFix"]
    },
    // Tabs
    {
      "before": ["<leader>", "o"],
      "commands": ["workbench.action.closeOtherEditors"]
    }
  ],
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": false,
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    }
  ],
  "github.copilot.nextEditSuggestions.enabled": false,
  "svelte.enable-ts-plugin": true,
  "explorer.confirmPasteNative": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "redhat.telemetry.enabled": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[mdx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "haskell.manageHLS": "GHCup",
  "github.copilot.nextEditSuggestions.fixes": false,
  "github.copilot.renameSuggestions.triggerAutomatically": false,
  "editor.tokenColorCustomizations": {
    "[Catppuccin Latte]": {
      "textMateRules": [
        {
          "scope": "keyword.other.preprocessor.pragma.haskell",
          "settings": {
            "foreground": "#dc8a78",
          }
        },
        {
          "scope": "keyword.other.preprocessor.haskell",
          "settings": {
            "foreground": "#dc8a78",
          }
        },
        {
          "scope": "meta.preprocessor.haskell",
          "settings": {
            "foreground": "#7c7f93",
          }
        }
      ]
    }
  },
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.colorTheme": "Catppuccin Mocha",
  "chat.agent.thinking.terminalTools": false,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://raw.githubusercontent.com": true,
    "https://docs.renovatebot.com": true
  }
}
